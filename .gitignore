# Dependencies
node_modules/
vendor/

# Build outputs
# js/ - NOT ignored, needed for App Store
dist/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Temporary files
*.swp
*.swo
*~

# Deployment artifacts
*.tar.gz
*.sig
intravox-deploy/

# Demo data images (downloaded/generated content)
demo-data/*/images/

# Logs
*.log

# Translation templates — only the POT source is tracked; per-language .po
# files are generated by the Nextcloud l10n sync-bot and land here on PR.
translationfiles/*
!translationfiles/templates/
!translationfiles/templates/*.pot

# l10n/en.json is a generated build artifact (scripts/extract-en-json.js); the
# NC Transifex bot also deletes it after sync. Never commit it.
# NOTE: l10n/.source-count.json IS committed on purpose — it holds the source-
# string total used as the denominator for the admin translation-coverage % at
# runtime (en.json is absent on the server). Do not add it here.
l10n/en.json

# Package lock files (use composer.lock for PHP)
package-lock.json

# Local development scripts (if any remain)
*.local.sh
*.local.js

# Deployment and release scripts (local use only)
create-release.sh
deploy-demo-data.sh
deploy.sh
deploy-*.sh
check-*.sh
# ...but the packaging guard is part of the release contract and must be
# reviewable and runnable in CI, so it is tracked deliberately.
!scripts/check-package-contents.sh

# Code signing certificates (private keys must never be committed!)
*.key
*.csr
*.crt
*.pem

# Backup files
*.bak

# macOS metadata
._*

# Claude Code configuration
.claude/
CLAUDE.md

# Internal documentation (for Gitea only, not GitHub)
docs/internal/

# Test data (local development only)
testdata/
.phpunit.cache/
scripts/.cache/

# Generated l10n build artefacts (must be absent on server)
l10n/en.js
l10n/.source-count.js

# Local scratch material: planning notes, forum drafts, screenshots and
# one-off POCs. These live in the working tree but are not part of the app,
# and must not reach the public repo.
/tasks/
/examples/
/forum-post-*.md

# Dated screenshot dumps from local sessions. The rest of screenshots/ is
# tracked on purpose — it is the App Store listing material.
/screenshots/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]_*.png

# Schemathesis fuzzer output. Regenerated on every contract-test run, read by
# nothing, and each file records the dev hostname it was fuzzed against — 65 of
# them reached the public mirror that way.
/.schemathesis/
